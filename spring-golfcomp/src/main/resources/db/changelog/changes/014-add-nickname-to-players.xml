<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="014-add-nickname-to-players" author="golfcomp">
        <comment>Add optional nickname column to players table - displayed on leaderboards in place of full name when set</comment>

        <addColumn tableName="players">
            <column name="nickname" type="varchar(50)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="players" columnName="nickname"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
