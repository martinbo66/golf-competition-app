<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Seed data for the 4 golf courses.
        
        These UUIDs must match exactly with the frontend hardcoded values in:
        vue-golfcomp/src/stores/courses.js
        
        The migration is idempotent - it will skip inserting if a course with
        the same ID already exists.
    -->

    <changeSet id="007-seed-courses-parkland" author="golfcomp" runOnChange="false">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(*) FROM courses WHERE id = '071aaf93-773e-49d0-935e-4b825e25670f'
                </sqlCheck>
            </not>
        </preConditions>
        <comment>Seed Parkland course</comment>
        <insert tableName="courses">
            <column name="id" value="071aaf93-773e-49d0-935e-4b825e25670f"/>
            <column name="name" value="Parkland"/>
            <column name="facility" valueComputed="NULL"/>
            <column name="location" valueComputed="NULL"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
    </changeSet>

