<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="010-seed-default-organization" author="golfcomp" runOnChange="false">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(*) FROM organizations WHERE id = 'a0000000-0000-0000-0000-000000000001'
                </sqlCheck>
            </not>
        </preConditions>
        <comment>Seed the default organization</comment>
        <insert tableName="organizations">
            <column name="id" value="a0000000-0000-0000-0000-000000000001"/>
            <column name="name" value="Default"/>
            <column name="slug" value="default"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
    </changeSet>

</databaseChangeLog>
