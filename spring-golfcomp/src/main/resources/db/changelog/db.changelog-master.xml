<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- 
        Golf Competition App - Master Changelog
        
        This file includes all database migration changesets.
        Add new migration files to the 'changes' directory and include them below.
        
        Naming convention: NNN-description.xml (e.g., 001-create-competitions-table.xml)
    -->

    <!-- Entity migrations -->
    <include file="changes/001-create-competitions-table.xml" relativeToChangelogFile="true"/>
    <include file="changes/002-create-courses-table.xml" relativeToChangelogFile="true"/>
    <include file="changes/003-create-rounds-table.xml" relativeToChangelogFile="true"/>
    <include file="changes/004-create-teams-table.xml" relativeToChangelogFile="true"/>
    <include file="changes/005-create-players-table.xml" relativeToChangelogFile="true"/>
    <include file="changes/006-create-scores-table.xml" relativeToChangelogFile="true"/>

    <!-- Seed data -->
    <include file="changes/007-seed-courses.xml" relativeToChangelogFile="true"/>

    <!-- Schema corrections -->
    <include file="changes/008-update-score-value-constraint.xml" relativeToChangelogFile="true"/>

    <!-- Multi-tenant support -->
    <include file="changes/009-create-organizations-table.xml" relativeToChangelogFile="true"/>
    <include file="changes/010-seed-default-organization.xml" relativeToChangelogFile="true"/>
    <include file="changes/011-add-organization-to-competitions.xml" relativeToChangelogFile="true"/>
    <include file="changes/012-fix-uuid-column-types-postgresql.xml" relativeToChangelogFile="true"/>
    <include file="changes/013-rename-default-organization.xml" relativeToChangelogFile="true"/>

    <!-- Player enhancements -->
    <include file="changes/014-add-nickname-to-players.xml" relativeToChangelogFile="true"/>

    <!-- Money / payouts -->
    <include file="changes/015-create-payouts-table.xml" relativeToChangelogFile="true"/>
    <include file="changes/016-add-paid-to-payouts.xml" relativeToChangelogFile="true"/>

</databaseChangeLog>
